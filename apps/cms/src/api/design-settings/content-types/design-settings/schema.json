{
  "kind": "singleType",
  "collectionName": "design_settings",
  "info": {
    "singularName": "design-setting",
    "pluralName": "design-settings",
    "displayName": "Design Settings",
    "description": "Global site design tokens (colors, typography, identity, header, hero, footer). Any change triggers a Next.js ISR revalidation webhook."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "colors": {
      "type": "json",
      "required": true,
      "default": {
        "gold": "#D4AF37",
        "void": "#0A0A0B",
        "obsidian": "#121214",
        "alabaster": "#F5F4F2",
        "muted": "#A8A8A8",
        "goldSubtle": "rgba(212,175,55,0.15)"
      }
    },
    "typography": {
      "type": "json",
      "required": true,
      "default": {
        "headingFont": "Bodoni Moda",
        "bodyFont": "Inter",
        "monoFont": "JetBrains Mono",
        "headingTracking": "-0.02em",
        "bodySize": "1rem"
      }
    },
    "siteIdentity": {
      "type": "json",
      "required": true,
      "default": {
        "logo": "",
        "wordmark": "HexaStudio",
        "tagline": "Living Spaces. Visualized."
      }
    },
    "header": {
      "type": "json",
      "required": true,
      "default": {
        "variant": "transparent",
        "menu": []
      }
    },
    "hero": {
      "type": "json",
      "required": true,
      "default": {
        "variant": "void-garden",
        "monolithCount": 24,
        "showChapterRail": true
      }
    },
    "footer": {
      "type": "json",
      "required": true,
      "default": {
        "kicker": "Hexa Studio — Architectural Visualization",
        "cta": "Let's build — something extraordinary.",
        "wordmarkItalic": true
      }
    },
    "customCss": {
      "type": "text",
      "default": ""
    }
  }
}
