{
  "expo": {
    "name": "HEXA Studio",
    "slug": "hexastudio-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hexastudio.mobile",
      "config": {
        "googleSignIn": {
          "reservedClientId": "com.googleusercontent.apps.000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.hexastudio.mobile",
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#6366F1",
        "channelId": "default"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/${EAS_PROJECT_ID}",
      "enabled": true,
      "fallbackToCacheTimeout": 30000,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366F1",
          "androidMode": "default",
          "androidCollapsedTitle": "HEXA Studio"
        }
      ],
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.hexastudio.net",
      "cmsUrl": "https://cms.hexastudio.net",
      "eas": {
        "projectId": "${EAS_PROJECT_ID}"
      }
    },
    "description": "See scripts/eas-build-setup.md for EAS project setup, credential configuration, and CI/CD variable setup."
  }
}
