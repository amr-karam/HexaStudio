{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  // WIP: src/mcp-server.ts imports placeholder packages ('mcp-server', '@mcpserver/stdio') that do not
  // exist on npm and implements a fictional API. It is not referenced by any entry point (real stdio
  // entry: src/mcp-stdio.ts). Excluded from build until rewritten against @modelcontextprotocol/sdk.
  "exclude": ["node_modules", "dist", "src/mcp-server.ts"]
}