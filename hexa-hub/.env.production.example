# =============================================================================
# HEXA Hub - Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in the values
# NEVER commit actual secrets to version control

# ===== DATABASE =====
POSTGRES_USER=hub_user
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=hub_db

# ===== JWT AUTHENTICATION =====
# Use a strong random string for JWT secret (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_to_a_random_string

# ===== REDIS CONFIGURATION =====
REDIS_URL=redis://hub-redis:6379

# ===== CORS SETTINGS =====
# Comma-separated list of allowed origins
CORS_ORIGINS=https://hexastudio.net,https://hub.hexastudio.net,https://www.hexastudio.net

# ===== OBJECT STORAGE (MINIO) =====
MINIO_ENDPOINT=hub-minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hub-files

# ===== ODOO INTEGRATION (OPTIONAL) =====
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_odoo_database
ODOO_USERNAME=your_odoo_username
ODOO_PASSWORD=your_odoo_password

# ===== SENTRY ERROR TRACKING =====
# Get your DSN from https://sentry.io
SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0

# ===== ADMIN CREDENTIALS (FOR FIRST SETUP) =====
ADMIN_USERNAME=admin@hexastudio.net
ADMIN_PASSWORD=your_secure_admin_password_here

# ===== JWT SETTINGS =====
# Admin JWT secret (different from main JWT secret)
ADMIN_JWT_SECRET=admin_secret_key_change_this_too

# ===== API KEYS =============
# API token salt for Strapi
API_TOKEN_SALT=your_api_token_salt_here

# ===== TRANSFER TOKENS ========
# Transfer tokens for Strapi
TRANSFER_TOKENS=your_transfer_tokens_here

# ===== APP KEYS =============
# App keys for Strapi encryption
APP_KEYS=key1,key2

# ===== SENTRY SETTINGS =====
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ===== NODE ENVIRONMENT =====
NODE_ENV=production

# ===== PORT CONFIGURATION ===
PORT=3000

# ===== NEXT.JS PUBLIC VARIABLES =====
NEXT_PUBLIC_API_URL=https://api.hexastudio.net
NEXT_PUBLIC_REALTIME_URL=wss://realtime.hexastudio.net
NEXT_PUBLIC_APP_URL=https://hub.hexastudio.net