# =============================================================================
# HEXA Hub — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# This file is read by Docker Compose via variable substitution (${VAR:-default}).
# The API app also reads these via @nestjs/config (ConfigModule).
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=hub_user
DB_PASSWORD=hub_password
DB_NAME=hub_db
DB_SYNCHRONIZE=true
DB_RUN_MIGRATIONS=true
DB_LOGGING=false

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT Authentication ────────────────────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET before deploying to production!
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Odoo ERP Integration ──────────────────────────────────────────────────────
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_WEBHOOK_SECRET=

# ─── MinIO Object Storage ──────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hexa-docs

# ─── AI Services ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Hermes Multi-Agent System ───────────────────────────────────────────────
# LM Studio compatible endpoint for local LLM inference.
# Hermes-3 models provide open-source agent reasoning capabilities.
# Install LM Studio and load a Hermes model (e.g. "NousResearch/hermes-3-llama-3.1-8b").
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=NousResearch/hermes-3-llama-3.1-8b

# OpenAI API key (used when LM Studio is not available — set to empty to use local)
OPENAI_API_KEY=

# ─── Qdrant Vector DB ───────────────────────────────────────────────────────
# Used by the Knowledge Agent for semantic search over indexed documents.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ─── Strapi CMS ─────────────────────────────────────────────────────────────
# Used by the Knowledge Agent for CMS content search.
STRAPI_URL=
STRAPI_TOKEN=

# ─── Worker (BullMQ) ──────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
LOG_LEVEL=info

# ─── SMTP (Email Delivery) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hexastudio.net

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# These are prefixed with NEXT_PUBLIC_ so they are embedded at build time.
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_REALTIME_URL=http://localhost:3002
