# =============================================================================
# HEXA Hub — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# This file is read by Docker Compose via variable substitution (${VAR:-default}).
# The API app also reads these via @nestjs/config (ConfigModule).
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=hub_user
DB_PASSWORD=hub_password
DB_NAME=hub_db
DB_SYNCHRONIZE=true
DB_RUN_MIGRATIONS=true
DB_LOGGING=false

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT Authentication ────────────────────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET before deploying to production!
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Odoo ERP Integration ──────────────────────────────────────────────────────
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_WEBHOOK_SECRET=

# ─── MinIO Object Storage ──────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hexa-docs

# ─── AI Services ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Worker (BullMQ) ──────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
LOG_LEVEL=info

# ─── SMTP (Email Delivery) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hexastudio.net

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# These are prefixed with NEXT_PUBLIC_ so they are embedded at build time.
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_REALTIME_URL=http://localhost:3002
