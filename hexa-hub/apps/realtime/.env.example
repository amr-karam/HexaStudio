# HEXA Hub Realtime — Environment Variables
# Copy to .env and adjust for your environment.

PORT=3001
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production

# Heartbeat settings (ms)
HEARTBEAT_INTERVAL=25000
HEARTBEAT_TIMEOUT=60000

# CORS (comma-separated origins) — production MUST set an explicit allowlist, NOT *
CORS_ORIGIN=https://hexastudio.net

# Logging
DEBUG=false

# Sentry Error Tracking
SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
NODE_ENV=development