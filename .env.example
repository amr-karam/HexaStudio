# Database
POSTGRES_PASSWORD=your_secure_postgres_password_here
ODOO_DB_PASSWORD=your_secure_odoo_db_password_here

# Redis
REDIS_PASSWORD=your_secure_redis_password_here

# MinIO
MINIO_ROOT_PASSWORD=your_secure_minio_password_here

# Grafana
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here
# Required by docker-compose.yml (grafana service) — no default fallback
GRAFANA_PASSWORD=your_secure_grafana_password_here

# Meilisearch (docker-compose.yml — no default fallback)
MEILISEARCH_MASTER_KEY=your_secure_meilisearch_master_key_here

# Sentry (gitlab-docker-compose.full.yml — no default fallback)
SENTRY_DB_PASSWORD=your_secure_sentry_db_password_here
SENTRY_REDIS_PASSWORD=your_secure_sentry_redis_password_here
SENTRY_SECRET_KEY=your_secure_sentry_secret_key_here

# OpenCode Desktop/SSH
OPENCODE_PASSWORD=your_secure_opencode_password_here

# Secrets & AI Engines
GEMINI_API_KEY=your_google_gemini_api_key_here
JWT_SECRET=your_secure_jwt_secret_here
STRAPI_ADMIN_JWT_SECRET=your_secure_strapi_admin_jwt_secret_here
STRAPI_API_TOKEN_SALT=your_api_token_salt_here
STRAPI_TRANSFER_TOKEN_SALT=your_transfer_token_salt_here
STRAPI_JWT_SECRET=your_strapi_jwt_secret_here
STRAPI_APP_KEYS=your_app_keys_here

# Odoo
ODOO_PASSWORD=your_secure_odoo_password_here

# Cloudflare
CLOUDFLARE_EMAIL=your_cloudflare_email_here
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Traefik dashboard / Alertmanager basic auth (docker/traefik/dynamic.yml — no default fallback)
# Generate the hash: htpasswd -nbB <user> '<password>'   (bcrypt)
TRAEFIK_AUTH_USER=admin
TRAEFIK_AUTH_HASH=your_secure_traefik_auth_hash_here

# Hostinger DNS
HOSTINGER_API_KEY=your_hostinger_api_key_here
DNS_DOMAIN=hexastudio.net
# Replace with your server's public IP (used by docker-compose.yml CORS_ORIGINS and scripts/dns-hostinger.ts)
SERVER_IP=your-server-ip

# --- docker-compose.prod.yml required (no default fallback) ---
# RSA key pair for backend JWT (PEM format). Generate with:
#   openssl genrsa -out jwt_private.pem 2048 && openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Then paste single-line escaped contents, or wire via file-based secrets.
JWT_PRIVATE_KEY=your_jwt_private_key_pem_here
JWT_PUBLIC_KEY=your_jwt_public_key_pem_here
# MinIO host used by backup jobs (must include :9000, e.g. minio:9000)
MINIO_ENDPOINT=minio:9000
# Odoo production secrets
ODOO_MASTER_PASSWORD=your_secure_odoo_master_password_here
ODOO_WEBHOOK_SECRET=your_secure_odoo_webhook_secret_here