  "known_issues": [
    {
      "issue": "Cloudflare Tunnel 'Unauthorized: Tunnel not found'",
      "cause": "Container token expired or references deleted/non-existent tunnel",
      "fix": "GET fresh token via API POST /accounts/{id}/tunnels/{id}/tokens, restart container with new token"
    },
    {
      "issue": "Backend 'JwtStrategy requires a secret or key' crash loop",
      "cause": "JWT_PUBLIC_KEY + JWT_PRIVATE_KEY not passed via docker-compose environment (JWT_SECRET alone is not enough for RS256)",
      "fix": "Add JWT_PUBLIC_KEY and JWT_PRIVATE_KEY to docker-compose.prod.yml backend environment, regenerate if needed via openssl"
    },
    {
      "issue": "Cloudflare zone stuck in 'pending' status",
      "cause": "Domain not registered at registrar, or nameservers not pointed to Cloudflare",
      "fix": "Register domain at registrar, update nameservers to Cloudflare (kip.ns.cloudflare.com, lara.ns.cloudflare.com)"
    },
    {
      "issue": "package-lock.json missing Linux binaries",
      "cause": "Lockfile generated on Windows omits native binaries for Linux packages",
      "fix": "Regenerate lockfile on Linux (node:20.20.2-bookworm-slim) with npm install --legacy-peer-deps"
    },
    {
      "issue": "npm start crashes in container (Lifecycle script failed)",
      "cause": "Backend crashes during bootstrap (DI errors, missing env vars, Odoo connection issues)",
      "fix": "Check docker logs, fix DI cycles, ensure all required env vars present"
    }
  ],
