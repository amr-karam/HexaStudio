{
  "name": "hexastudio",
  "version": "1.0.0",
  "private": true,
  "description": "HexaStudio.net — 3D creative studio platform",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "ci:validate": "node scripts/validate-gitlab-ci.js",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:cms": "turbo run dev --filter=cms",
    "dev:frontend": "turbo run dev --filter=frontend",
    "dev:mobile": "turbo run start --filter=mobile",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:up": "docker compose up -d",
    "gitlab:deploy": "bash scripts/deploy-gitlab.sh",
    "gitlab:runner:register": "bash scripts/register-gitlab-runner.sh",
    "gitlab:setup": "bash scripts/setup-gitlab-variables.sh",
    "gitlab:migrate": "bash scripts/migrate-from-github.sh",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "npm run test:e2e --workspace=apps/frontend",
    "test:e2e:ui": "playwright test --ui --config e2e/playwright.config.ts",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "@google/genai": "2.15.0",
    "@playwright/test": "^1.62.1",
    "@react-navigation/bottom-tabs": "7.18.14",
    "@react-navigation/native": "7.3.14",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/core": "10.69.0",
    "@sentry/nextjs": "^10.65.0",
    "axios": "^1.18.1",
    "framer-motion": "^11.18.2",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.460.0",
    "react-error-boundary": "^6.1.2"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@lhci/cli": "^0.14.0",
    "@nestjs/cli": "^11.0.24",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.1.1",
    "axe-core": "^4.13.0",
    "caniuse-lite": "^1.0.30001806",
    "jest-axe": "^11.0.0",
    "react-test-renderer": "19.2.8",
    "turbo": "^2.10.4"
  },
  "overrides": {
    "framer-motion": "^11.18.2",
    "cookie": "^0.7.2",
    "tmp": ">=0.2.2",
    "uuid": "^11.1.1",
    "postcss": "^8.5.10",
    "sharp": "^0.35.3",
    "@types/react": "19.2.17",
    "@xmldom/xmldom": ">=0.9.0",
    "js-yaml": "^5.2.2",
    "react-test-renderer": "19.2.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "next": "16.2.11"
  },
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "apps/mobile",
    "packages/types",
    "packages/ui",
    "packages/utils"
  ],
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.2",
    "@rolldown/binding-win32-x64-msvc": "1.2.2"
  }
}
