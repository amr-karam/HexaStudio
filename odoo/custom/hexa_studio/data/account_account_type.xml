<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================================ -->
        <!-- ASSET TYPES                                                   -->
        <!-- ============================================================ -->
        <record id="hexa_account_type_asset_current" model="account.account.type">
            <field name="name">Current Assets</field>
            <field name="type">asset</field>
            <field name="internal_group">asset</field>
            <field name="include_initial_balance" eval="True"/>
        </record>

        <record id="hexa_account_type_asset_fixed" model="account.account.type">
            <field name="name">Fixed Assets</field>
            <field name="type">asset</field>
            <field name="internal_group">asset</field>
            <field name="include_initial_balance" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- LIABILITY TYPES                                               -->
        <!-- ============================================================ -->
        <record id="hexa_account_type_liability_current" model="account.account.type">
            <field name="name">Current Liabilities</field>
            <field name="type">liability</field>
            <field name="internal_group">liability</field>
            <field name="include_initial_balance" eval="True"/>
        </record>

        <record id="hexa_account_type_liability_non_current" model="account.account.type">
            <field name="name">Non-Current Liabilities</field>
            <field name="type">liability</field>
            <field name="internal_group">liability</field>
            <field name="include_initial_balance" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- EQUITY TYPE                                                   -->
        <!-- ============================================================ -->
        <record id="hexa_account_type_equity" model="account.account.type">
            <field name="name">Equity</field>
            <field name="type">equity</field>
            <field name="internal_group">equity</field>
            <field name="include_initial_balance" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- INCOME TYPES                                                  -->
        <!-- ============================================================ -->
        <record id="hexa_account_type_income" model="account.account.type">
            <field name="name">Operating Revenue</field>
            <field name="type">income</field>
            <field name="internal_group">income</field>
            <field name="include_initial_balance" eval="False"/>
        </record>

        <record id="hexa_account_type_income_other" model="account.account.type">
            <field name="name">Other Income</field>
            <field name="type">income</field>
            <field name="internal_group">income</field>
            <field name="include_initial_balance" eval="False"/>
        </record>

        <!-- ============================================================ -->
        <!-- EXPENSE TYPES                                                 -->
        <!-- ============================================================ -->
        <record id="hexa_account_type_expense" model="account.account.type">
            <field name="name">Operating Expenses</field>
            <field name="type">expense</field>
            <field name="internal_group">expense</field>
            <field name="include_initial_balance" eval="False"/>
        </record>

        <record id="hexa_account_type_expense_depreciation" model="account.account.type">
            <field name="name">Depreciation Expense</field>
            <field name="type">expense</field>
            <field name="internal_group">expense</field>
            <field name="include_initial_balance" eval="False"/>
        </record>

        <record id="hexa_account_type_expense_direct_cost" model="account.account.type">
            <field name="name">Direct Project Costs</field>
            <field name="type">expense</field>
            <field name="internal_group">expense</field>
            <field name="include_initial_balance" eval="False"/>
        </record>

        <!-- ============================================================ -->
        <!-- FULL ACCOUNTANT DEPARTMENT - ADVANCED ACCOUNT TYPES           -->
        <!-- ============================================================ -->
        <record id="hexa_account_type_expense_admin" model="account.account.type">
            <field name="name">Administrative Expenses</field>
            <field name="type">expense</field>
            <field name="internal_group">expense</field>
            <field name="include_initial_balance" eval="False"/>
        </record>

        <record id="hexa_account_type_expense_selling" model="account.account.type">
            <field name="name">Selling Expenses</field>
            <field name="type">expense</field>
            <field name="internal_group">expense</field>
            <field name="include_initial_balance" eval="False"/>
        </record>

        <record id="hexa_account_type_income_operating" model="account.account.type">
            <field name="name">Operating Income</field>
            <field name="type">income</field>
            <field name="internal_group">income</field>
            <field name="include_initial_balance" eval="False"/>
        </record>

        <record id="hexa_account_type_income_gain" model="account.account.type">
            <field name="name">Gains</field>
            <field name="type">income</field>
            <field name="internal_group">income</field>
            <field name="include_initial_balance" eval="False"/>
        </record>

        <record id="hexa_account_type_expense_loss" model="account.account.type">
            <field name="name">Losses</field>
            <field name="type">expense</field>
            <field name="internal_group">expense</field>
            <field name="include_initial_balance" eval="False"/>
        </record>

        <record id="hexa_account_type_other_current" model="account.account.type">
            <field name="name">Other Current Assets</field>
            <field name="type">asset</field>
            <field name="internal_group">asset</field>
            <field name="include_initial_balance" eval="True"/>
        </record>

        <record id="hexa_account_type_other_non_current" model="account.account.type">
            <field name="name">Other Non-Current Assets</field>
            <field name="type">asset</field>
            <field name="internal_group">asset</field>
            <field name="include_initial_balance" eval="True"/>
        </record>
    </data>
</odoo>
