<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- NATIONAL — Default fiscal position                            -->
        <!-- Maps all taxes to themselves (no remapping)                   -->
        <!-- ============================================================ -->
        <record id="hexa_fiscal_position_national" model="account.fiscal.position">
            <field name="name">National</field>
            <field name="auto_apply" eval="False"/>
            <field name="vat_required" eval="True"/>
            <field name="note">Default fiscal position for domestic transactions. All taxes apply as configured.</field>
        </record>

        <!-- ============================================================ -->
        <!-- EXPORT — Maps VAT 15% → VAT 0% Export                        -->
        <!-- ============================================================ -->
        <record id="hexa_fiscal_position_export" model="account.fiscal.position">
            <field name="name">Export</field>
            <field name="auto_apply" eval="False"/>
            <field name="vat_required" eval="False"/>
            <field name="note">Export fiscal position. Maps domestic VAT to 0% export rate.</field>
        </record>

        <!-- Tax mapping: VAT 15% Sales → VAT 0% Export -->
        <record id="hexa_fp_export_tax_sales" model="account.fiscal.position.tax">
            <field name="position_id" ref="hexa_fiscal_position_export"/>
            <field name="tax_src_id" ref="hexa_tax_vat_sales_15"/>
            <field name="tax_dest_id" ref="hexa_tax_vat_export"/>
        </record>

        <!-- Tax mapping: VAT 15% Purchases → VAT 0% Export -->
        <record id="hexa_fp_export_tax_purchase" model="account.fiscal.position.tax">
            <field name="position_id" ref="hexa_fiscal_position_export"/>
            <field name="tax_src_id" ref="hexa_tax_vat_purchase_15"/>
            <field name="tax_dest_id" ref="hexa_tax_vat_export"/>
        </record>

    </data>
</odoo>
