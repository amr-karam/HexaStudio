<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- SALES JOURNAL                                                 -->
        <!-- ============================================================ -->
        <record id="hexa_journal_sales" model="account.journal">
            <field name="name">Customer Invoices</field>
            <field name="code">SINV</field>
            <field name="type">sale</field>
            <field name="default_account_id" ref="hexa_account_102100"/>
            <field name="refund_sequence" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- PURCHASE JOURNAL                                              -->
        <!-- ============================================================ -->
        <record id="hexa_journal_purchase" model="account.journal">
            <field name="name">Vendor Bills</field>
            <field name="code">PINV</field>
            <field name="type">purchase</field>
            <field name="default_account_id" ref="hexa_account_201100"/>
            <field name="refund_sequence" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- BANK JOURNAL                                                  -->
        <!-- ============================================================ -->
        <record id="hexa_journal_bank" model="account.journal">
            <field name="name">Bank</field>
            <field name="code">BANK</field>
            <field name="type">bank</field>
            <field name="default_account_id" ref="hexa_account_101100"/>
        </record>

        <!-- ============================================================ -->
        <!-- CASH JOURNAL                                                  -->
        <!-- ============================================================ -->
        <record id="hexa_journal_cash" model="account.journal">
            <field name="name">Cash</field>
            <field name="code">CASH</field>
            <field name="type">cash</field>
            <field name="default_account_id" ref="hexa_account_101200"/>
        </record>

        <!-- ============================================================ -->
        <!-- MISCELLANEOUS JOURNAL                                         -->
        <!-- ============================================================ -->
        <record id="hexa_journal_misc" model="account.journal">
            <field name="name">Miscellaneous Operations</field>
            <field name="code">MISC</field>
            <field name="type">general</field>
        </record>

    </data>
</odoo>
