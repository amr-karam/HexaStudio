# ============================================================================
# HEXA STUDIO STAGING ENVIRONMENT
# ============================================================================
# Copy this file to .env.staging.local and fill in actual values
# Required variables (marked with :? in docker-compose) MUST be set
# ============================================================================

# ---------------------------------------------------------------------------
# Cloudflare / Traefik TLS
# ---------------------------------------------------------------------------
CLOUDFLARE_EMAIL=your-cloudflare-email@example.com
CLOUDFLARE_API_KEY=your-cloudflare-global-api-key
CLOUDFLARE_TUNNEL_TOKEN_STAGING=your-cloudflare-tunnel-token-for-staging

# ---------------------------------------------------------------------------
# Traefik Dashboard (optional - has defaults)
# ---------------------------------------------------------------------------
TRAEFIK_DASHBOARD_HOST=traefik-staging.hexastudio.net

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=hexastudio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=hexastudio

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ---------------------------------------------------------------------------
# MinIO / Object Storage
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=hexastudio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# ---------------------------------------------------------------------------
# Backend Application
# ---------------------------------------------------------------------------
NODE_ENV=staging
BACKEND_PORT=14000
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_32_CHARS_MIN
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:13000,https://staging.hexastudio.net
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Odoo ERP
# ---------------------------------------------------------------------------
ODOO_HOST=odoo
ODOO_PORT=18069
ODOO_DB=hexastudio_odoo
ODOO_USER=admin
ODOO_PASSWORD=CHANGE_ME_STRONG_ODOO_PASSWORD
ODOO_WEBHOOK_SECRET=CHANGE_ME_STRONG_ODOO_WEBHOOK_SECRET
ODOO_MASTER_PASSWORD=CHANGE_ME_STRONG_ODOO_MASTER_PASSWORD

# ---------------------------------------------------------------------------
# Strapi CMS
# ---------------------------------------------------------------------------
STRAPI_PORT=11337
STRAPI_APP_KEYS=CHANGE_ME_4_KEYS_COMMA_SEPARATED_32_CHARS_EACH
STRAPI_API_TOKEN_SALT=CHANGE_ME_STRONG_API_TOKEN_SALT
STRAPI_ADMIN_JWT_SECRET=CHANGE_ME_STRONG_ADMIN_JWT_SECRET
STRAPI_TRANSFER_TOKEN_SALT=CHANGE_ME_STRONG_TRANSFER_TOKEN_SALT
STRAPI_JWT_SECRET=CHANGE_ME_STRONG_STRAPI_JWT_SECRET
CLIENT_URL=https://staging.hexastudio.net
CMS_URL=http://cms:11337
PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api-staging.hexastudio.net
NEXT_PUBLIC_CMS_URL=https://cms-staging.hexastudio.net
NEXT_PUBLIC_SITE_URL=https://staging.hexastudio.net
NEXT_PUBLIC_SENTRY_DSN=
REVALIDATE_SECRET=CHANGE_ME_REVALIDATE_SECRET
PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Monitoring (Grafana)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
GRAFANA_HOST=grafana-staging.hexastudio.net

# ---------------------------------------------------------------------------
# Notifications (Optional)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=